{
	"$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
	"files": {
		"includes": [
			"**",
			"!node_modules",
			"!**/.turbo",
			"!**/.parcel-cache",
			"!**/coverage",
			"!**/dist",
			"!**/playwright-report",
			"!**/test-results",
			"!modern-backbone/test/upstream/vendor"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 100
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single",
			"semicolons": "always"
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended"
		}
	}
}
